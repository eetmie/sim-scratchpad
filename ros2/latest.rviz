Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: excavator_rviz/Terrain
    Name: Terrain
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 20
    - Class: rviz_default_plugins/RobotModel
      Name: Excavator
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
      Alpha: 0.8
    - Class: rviz_default_plugins/PointCloud2
      Name: FastDEM accumulated terrain
      Enabled: true
      Topic:
        Value: /fastdem/mapping/cloud
        Reliability Policy: Best Effort
        Depth: 1
      Style: Boxes
      Size (m): 0.01
      Color Transformer: AxisColor
      Axis: Z
      Autocompute Value Bounds: false
      Min Value: -0.12
      Max Value: 0.12
      Decay Time: 0
    - Class: rviz_default_plugins/Image
      Name: Front heightmap (current observation)
      Enabled: true
      Topic:
        Value: /excavator/heightmap/image
        Reliability Policy: Best Effort
        Depth: 1
    - Class: rviz_default_plugins/Image
      Name: FastDEM surround (remembered)
      Enabled: true
      Topic:
        Value: /fastdem/mapping/image
        Reliability Policy: Best Effort
        Depth: 1
    - Class: rviz_default_plugins/Image
      Name: Cabin IR
      Enabled: true
      Topic:
        Value: /excavator/cameras/cabin/image_raw
        Reliability Policy: Best Effort
        Depth: 1
    - Class: rviz_default_plugins/Image
      Name: Boom IR
      Enabled: true
      Topic:
        Value: /excavator/cameras/arm/image_raw
        Reliability Policy: Best Effort
        Depth: 1
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.6
      Focal Point:
        X: 0.4
        Y: 0
        Z: 0
      Pitch: 0.6
      Yaw: 3.6
      Target Frame: world
Window Geometry:
  Width: 1400
  Height: 900
