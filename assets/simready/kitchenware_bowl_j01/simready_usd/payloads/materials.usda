def Scope "Materials"
{
    def Material "m_opaque__wood__bowl_j01" (
        prepend apiSchemas = ["SemanticsLabelsAPI:material"]
    )
    {
        custom token[] omni:simready:nonvisual:attributes = ["none"]
        custom token omni:simready:nonvisual:base = "wood"
        custom token omni:simready:nonvisual:coating = "none"
        token outputs:displacement (
            displayGroup = "Outputs"
        )
        token outputs:surface (
            displayGroup = "Outputs"
        )
        prepend token outputs:surface.connect = </Materials/m_opaque__wood__bowl_j01/Principled_BSDF.outputs:surface>
        token outputs:volume (
            displayGroup = "Outputs"
        )
        custom int pxr:usd:physics_density = 700
        custom double pxr:usd:physics_dynamicFriction = 0.5
        custom double pxr:usd:physics_fillRatio = 0.7
        custom double pxr:usd:physics_restitution = 0.4
        custom double pxr:usd:physics_staticFriction = 0.5
        custom double pxr:usd:physics_thickness = 0.02
        custom string pxr:usd:physics_type = "wood"
        token[] semantics:labels:material = ["wood"]

        def Shader "Principled_BSDF" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdPreviewSurface"
            float inputs:clearcoat = 0
            float inputs:clearcoatRoughness = 0.03
            prepend color3f inputs:diffuseColor.connect = </Materials/m_opaque__wood__bowl_j01/Albedo.outputs:rgb>
            float inputs:ior = 1.5
            prepend float inputs:metallic.connect = </Materials/m_opaque__wood__bowl_j01/ORM.outputs:b>
            prepend normal3f inputs:normal.connect = </Materials/m_opaque__wood__bowl_j01/Normal.outputs:rgb>
            float inputs:opacity = 1
            prepend float inputs:roughness.connect = </Materials/m_opaque__wood__bowl_j01/ORM.outputs:g>
            float inputs:specular = 0.5
            token outputs:surface
        }

        def Shader "Albedo" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdUVTexture"
            asset inputs:file = @../Textures/t_bowl_brown_j01_alb.png@
            token inputs:sourceColorSpace = "sRGB"
            prepend float2 inputs:st.connect = </Materials/m_opaque__wood__bowl_j01/uvmap.outputs:result>
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            float3 outputs:rgb
        }

        def Shader "uvmap" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdPrimvarReader_float2"
            string inputs:varname = "st"
            float2 outputs:result
        }

        def Shader "ORM" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdUVTexture"
            asset inputs:file = @../Textures/t_bowl_brown_j01_orm.png@
            token inputs:sourceColorSpace = "raw"
            prepend float2 inputs:st.connect = </Materials/m_opaque__wood__bowl_j01/uvmap.outputs:result>
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            float outputs:b
            float outputs:g
        }

        def Shader "Normal" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdUVTexture"
            float4 inputs:bias = (-1, -1, -1, -1)
            asset inputs:file = @../Textures/t_bowl_brown_j01_nor.png@
            float4 inputs:scale = (2, 2, 2, 2)
            token inputs:sourceColorSpace = "raw"
            prepend float2 inputs:st.connect = </Materials/m_opaque__wood__bowl_j01/uvmap.outputs:result>
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            float3 outputs:rgb
        }
    }
}

